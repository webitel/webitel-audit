# gRPC listen address
SERVICE_ADDR=127.0.0.1:8080

# gRPC TLS; verify_certs defaults to true and then needs CA/CERT/KEY (MTLS=true also requires client certs)
SERVICE_CONN_VERIFY_CERTS=false
#SERVICE_CONN_MTLS=true
#SERVICE_CONN_CA=
#SERVICE_CONN_CERT=
#SERVICE_CONN_KEY=

CONSUL_ADDR=127.0.0.1:8500

# Listen address of /livez /readyz /healthz; leave it unset to disable the probes
HEALTH_ADDR=127.0.0.1:8081

POSTGRES_DSN=postgres://user:pass@127.0.0.1:5432/webitel?sslmode=disable

# Max connections of the server pool; 0 keeps the pgx default (the larger of 4 and the CPU count).
# Other POSTGRES_* pool variables (idle conns, conn lifetime) are accepted but ignored.
#POSTGRES_MAX_OPEN_CONNS=0

# Optional path to a YAML/JSON config file
#CONFIG_FILE=

# Log level: debug, info, warn, error, any case (default: info)
#LOG_LEVEL=info
#LOG_JSON=false
#LOG_OTEL=false
#LOG_CONSOLE=true
#LOG_FILE=
