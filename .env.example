# gRPC listen address (not used until the gRPC server arrives)
SERVICE_ADDR=127.0.0.1:8080

# Listen address of /livez /readyz /healthz; leave it unset to disable the probes
HEALTH_ADDR=127.0.0.1:8081

# Optional path to a YAML/JSON config file
#CONFIG_FILE=

# Log level: debug, info, warn, error, any case (default: info)
#LOG_LEVEL=info
#LOG_JSON=false
#LOG_OTEL=false
#LOG_CONSOLE=true
#LOG_FILE=
